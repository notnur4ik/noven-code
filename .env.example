# ============================================================================
# NOVEN.CODE — SERVER ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure values for your deployment environment.
# ============================================================================

# Server HTTP Port & Environment
PORT=3000
NODE_ENV=production

# Initial Server-Side Setup Owner Account
# Hashed via scryptSync on initial database seeding; never exposed to client code.
INITIAL_OWNER_USERNAME=Notnur4ikGg
INITIAL_OWNER_PASSWORD=Nurik1107!)

# Telegram Bot API Integration (For instant order & CRM notifications to @notnormale)
# You can also configure these directly inside the CRM -> Settings panel as OWNER.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional PostgreSQL / Supabase Production Connection
# SQLite (db/noven_code.sqlite) is enabled out of the box via Node's native node:sqlite.
# Run db/migrations/001_initial_schema.sql on Supabase / PostgreSQL when deploying to cloud.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
